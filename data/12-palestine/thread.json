      "images": [
        "images/Evernote.jpg"
      ],
      "content": "<div class=\"abbs-post-photo-wrap\">\n  <img src=\"images/Evernote.jpg\" class=\"abbs-post-photo\" alt=\"一位在耶路撒冷外的巡游鞋匠 (An itinerant shoemaker outside Jerusalem)\" loading=\"lazy\" />\n</div>\n<p style=\"font-weight:600; margin-top:12px; color:var(--text-primary);\">一位在耶路撒冷外的巡游鞋匠 (An itinerant shoemaker outside Jerusalem)</p>\n<p style=\"color:var(--text-muted); font-size:0.95rem; line-height:1.7;\">1890年代的巴勒斯坦工匠在城门外为行人修补皮鞋。</p>"
    },
